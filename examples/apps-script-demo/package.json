{
  "name": "apps-script-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Generic Google Apps Script demo of the Sentropic design system (neutral theme, single offline HTML page).",
  "license": "MIT",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:fresh": "tsx scripts/build.ts --dist-only",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --import tsx --test scripts/self-check.test.ts scripts/contrast.test.ts scripts/diagram-fit.test.ts",
    "check": "tsx scripts/self-check.ts",
    "smoke": "tsx scripts/smoke-ssr.ts",
    "browser-check": "node scripts/browser-check.mjs",
    "demo": "npm run build && npm run check && npm run smoke",
    "ci": "npm run typecheck && npm test && npm run build:fresh && npm run check && npm run smoke"
  },
  "dependencies": {
    "@sentropic/design-system-svelte": "0.41.2",
    "@sentropic/design-system-themes": "0.14.0",
    "@sentropic/diagram-canvas": "0.2.2",
    "@sentropic/diagram-core": "0.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "25.9.9",
    "lightningcss": "1.33.0",
    "puppeteer-core": "25.17.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
