{
  "schemaVersion": 1,
  "id": "bpmn-events",
  "library": "bpmn",
  "kind": "bpmn-xml-f1",
  "title": "Timer and message intermediate events on a task chain",
  "xml": "<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"defs_ev\"><bpmn:process id=\"p1\"><bpmn:startEvent id=\"start\"/><bpmn:intermediateCatchEvent id=\"timer1\"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent><bpmn:intermediateThrowEvent id=\"msg1\"><bpmn:messageEventDefinition/></bpmn:intermediateThrowEvent><bpmn:endEvent id=\"end\"/></bpmn:process></bpmn:definitions>",
  "model": {
