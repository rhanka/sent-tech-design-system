      { "id": "timer1", "type": "bpmn:IntermediateCatchEvent", "x": 180, "y": 100, "width": 36, "height": 36, "label": "wait" },
      { "id": "msg1", "type": "bpmn:IntermediateThrowEvent", "x": 280, "y": 100, "width": 36, "height": 36, "label": "notify" },
      { "id": "end", "type": "bpmn:EndEvent", "x": 380, "y": 100, "width": 36, "height": 36, "label": "" }
