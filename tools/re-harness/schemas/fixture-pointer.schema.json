{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentropic.example/re-harness/fixture-pointer.schema.json",
  "title": "RE harness fixture: pointer and keyboard script (v1)",
  "description": "Viewport-coordinate pointer/keyboard sequences (SPEC_RE_XYFLOW_PARITY §6: driven by clientX/clientY computed from the model, never by library DOM selectors). Timestamps are harness steps, not wall-clock milliseconds.",
  "type": "object",
  "required": ["schemaVersion", "id", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["pointerdown", "pointermove", "pointerup", "wheel", "keydown", "keyup", "step"] },
          "clientX": { "type": "number" },
          "clientY": { "type": "number" },
          "key": { "type": "string" },
          "code": { "type": "string" },
          "deltaY": { "type": "number" },
          "atStep": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "additionalProperties": false
}
