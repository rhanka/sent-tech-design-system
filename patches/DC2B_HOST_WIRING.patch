diff --git a/packages/components-vue/src/DiagramSceneFigure.test.ts b/packages/components-vue/src/DiagramSceneFigure.test.ts
new file mode 100644
index 00000000..bc0b9532
--- /dev/null
+++ b/packages/components-vue/src/DiagramSceneFigure.test.ts
@@ -0,0 +1,43 @@
+import { defineComponent, nextTick, ref } from "vue";
+import { mount } from "@vue/test-utils";
+import { expect, it, vi } from "vitest";
+import DiagramSceneFigure from "./DiagramSceneFigure.vue";
+import { defineHostContract, hostProps } from "../../components-svelte/src/lib/DiagramSceneFigure.test-support.js";
+
+defineHostContract({
+  name: "Vue", flush: nextTick,
+  async mount(props) {
+    const { onSizeChange, ...figureProps } = props;
+    const contentSize = ref<{ width: number; height: number }>();
+    const Parent = defineComponent({
+      components: { DiagramSceneFigure },
+      setup: () => ({ figureProps, contentSize, notify: onSizeChange }),
+      template: '<DiagramSceneFigure v-bind="figureProps" v-model:contentSize="contentSize" @size-change="notify" />',
+    });
+    const parent = mount(Parent); await nextTick();
+    const figure = parent.findComponent(DiagramSceneFigure);
+    const viewport = parent.get<HTMLElement>(".st-diagramSceneFigure-viewport").element;
+    return {
+      viewport, size: () => contentSize.value,
+      toggle: async () => { await parent.get('button[aria-expanded]').trigger("click"); },
+      pan: async () => { viewport.scrollLeft++; viewport.dispatchEvent(new Event("scroll")); await nextTick(); },
+      zoom: async () => { viewport.dispatchEvent(new WheelEvent("wheel", { ctrlKey: true, deltaY: -1, cancelable: true })); await nextTick(); },
+      unmount(clearTemplateRef) {
+        if (clearTemplateRef) {
+          const state = figure.vm.$.setupState as { viewportEl: HTMLElement | undefined };
+          expect(state.viewportEl).toBe(viewport);
+          state.viewportEl = undefined;
+          expect(state.viewportEl).toBeUndefined();
+        }
+        parent.unmount();
+      },
+    };
+  },
+});
+
+it("should deliver an onSizeChange vnode listener once per layout", async () => {
+  const onSizeChange = vi.fn();
+  const view = mount(DiagramSceneFigure, { props: { ...hostProps, onSizeChange } as never });
+  try { await nextTick(); expect(onSizeChange).toHaveBeenCalledTimes(1); }
+  finally { view.unmount(); }
+});
