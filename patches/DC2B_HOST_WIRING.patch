+import { createLayoutCache, type DiagramSceneSize, type SceneLayoutCache, type LayoutCacheConfig, type LayoutCacheStats } from '@sentropic/design-system-vue';
+const config: LayoutCacheConfig = { maxEntries: 32 };
+const cache: SceneLayoutCache = createLayoutCache(config);
+const stats: LayoutCacheStats = cache.stats();
+const size: DiagramSceneSize = { width: 10, height: 20 };
+void [cache, stats, size];
+import { createLayoutCache as createVaporCache, type DiagramSceneSize as VaporSize, type SceneLayoutCache as VaporCache, type LayoutCacheConfig as VaporConfig, type LayoutCacheStats as VaporStats } from '@sentropic/design-system-vue/vapor';
+const vaporConfig: VaporConfig = config;
+const vaporCache: VaporCache = createVaporCache(vaporConfig);
+const vaporSize: VaporSize = size;
+const vaporStats: VaporStats = vaporCache.stats();
+void [vaporSize, vaporStats];
