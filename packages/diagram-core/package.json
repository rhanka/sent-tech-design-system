{
  "name": "@sentropic/diagram-core",
  "version": "0.1.0",
  "description": "Typed semantic core for diagrams: versioned documents and profiles, views with occurrences, transactional commands with logical inverses. No runtime dependency, no DOM, no framework.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.srchash",
    "schemas"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/diagram-core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/diagram-view-schema-3.json": "./schemas/diagram-view-schema-3.json",
    "./schemas/diagram-view-schema-3.sha256": "./schemas/diagram-view-schema-3.sha256"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  }
}
