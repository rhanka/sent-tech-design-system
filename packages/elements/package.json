{
  "name": "@sentropic/design-system-elements",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Sentropic design system custom elements for the JSON render catalogue (BarChart, BpmnCanvas, DecisionDossier): envelope validator plus CDN browser bundle.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/elements"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "catalog.json",
    "envelope.json",
    "schemas",
    "!dist/**/*.map",
    "!dist/.srchash"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./catalog.json",
    "./envelope.json": "./envelope.json",
    "./schemas/*": "./schemas/*"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.dom.json",
    "test": "vitest run",
    "catalog:generate": "node dist/generator/main.js",
    "catalog:check": "node dist/generator/main.js --check"
  },
  "dependencies": {
    "@sentropic/bpmn-canvas": "0.3.0",
    "@sentropic/focus": "0.5.0",
    "ajv": "8.20.0",
    "dompurify": "3.4.17",
    "svelte": "5.55.7"
  },
  "devDependencies": {
    "@a2ui/web_core": "0.14.0",
    "@json-render/svelte": "0.21.3",
    "ts-json-schema-generator": "2.9.0"
  }
}
