{
  // `npm run check` compiles the TESTS too (diagram-core precedent): the RED
  // witness tests read the committed artifacts from disk with node builtins,
  // and parity/contract assertions that only mean something under the
  // compiler belong in here. The build configuration stays test-free.
  // The DOM half of the element layer (src/element/dom) is checked by
  // tsconfig.dom.json instead — it needs the DOM lib. The two witness
  // suites that exercise that half (the runtime B7/B8/B1 holder and the
  // DOMPurify restriction) move with it, so neither project compiles a
  // DOM source without the DOM lib (review 1).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "tests"],
  "exclude": ["dist", "node_modules", "src/element/dom", "tests/element-runtime.test.ts", "tests/element-sanitizer.test.ts"]
}
