{
  "contract": "1.0",
  "root": {
    "component": "BpmnCanvas",
    "id": "root",
    "document": {
      "$type": "bpmn:Definitions",
      "id": "order-process-definitions",
      "targetNamespace": "https://example.com/order",
      "rootElements": [
        {
          "$type": "bpmn:Process",
          "id": "order-process",
          "isExecutable": false,
          "name": "Order process",
          "flowElements": [
            {
              "$type": "bpmn:StartEvent",
              "id": "event-order-received",
              "name": "Order received"
            },
            {
              "$type": "bpmn:Task",
              "id": "task-check-payment",
              "name": "Check payment"
            },
            {
              "$type": "bpmn:ExclusiveGateway",
              "id": "gateway-paid",
              "name": "Paid?"
            },
            {
              "$type": "bpmn:Task",
              "id": "task-ship-order",
              "name": "Ship order"
            },
            {
              "$type": "bpmn:Task",
              "id": "task-chase-payment",
              "name": "Chase payment"
            },
            {
              "$type": "bpmn:EndEvent",
              "id": "event-order-shipped",
              "name": "Order shipped"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "flow-received-to-check",
              "sourceRef": "event-order-received",
              "targetRef": "task-check-payment"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "flow-check-to-gateway",
              "sourceRef": "task-check-payment",
              "targetRef": "gateway-paid"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "flow-gateway-to-ship",
              "name": "yes",
              "sourceRef": "gateway-paid",
              "targetRef": "task-ship-order"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "flow-gateway-to-chase",
              "name": "no",
              "sourceRef": "gateway-paid",
              "targetRef": "task-chase-payment"
            },
            {
              "$type": "bpmn:SequenceFlow",
              "id": "flow-ship-to-end",
              "sourceRef": "task-ship-order",
              "targetRef": "event-order-shipped"
            }
          ]
        }
      ],
      "diagrams": [
        {
          "$type": "bpmndi:BPMNDiagram",
          "id": "order-process-diagram",
          "plane": {
