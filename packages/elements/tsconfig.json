{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // NO "DOM" in lib: the validator, the ports and the contracts stay DOM-free
    // by compilation. Unlike diagram-core, `types` is ["node"] because the
    // CATALOG GENERATOR (src/generator) is a Node CLI that reads and writes
    // the committed artifacts; the purity of the runtime half (validate, ports,
    // contracts) is enforced by tests/purity.test.ts instead of by `types: []`.
    "lib": ["ES2022"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/element/dom"]
}
