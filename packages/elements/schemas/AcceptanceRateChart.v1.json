{
  "$defs": {
    "CatalogComponentCommon": {
      "properties": {
        "weight": {
          "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "component": {
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9_1/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "properties": {
            "acceptedLabel": {
              "description": "Name of the accepted outcome in labels. Default \"accepted\".",
              "maxLength": 24,
              "minLength": 1,
              "type": "string"
            },
            "accessibility": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "component": {
              "const": "AcceptanceRateChart"
            },
            "items": {
              "description": "Systems or configurations to compare.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "accepted": {
                    "description": "Accepted count.",
                    "maximum": 1000000000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "id": {
                    "description": "Stable identifier, unique within the chart.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._:-]+$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable name.",
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "total": {
                    "description": "Total evaluated count.",
                    "maximum": 1000000000,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "accepted",
                  "id",
                  "label",
                  "total"
                ],
                "type": "object"
              },
              "maxItems": 24,
              "minItems": 1,
              "type": "array"
            },
            "label": {
              "description": "Chart name and accessible name.",
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "order": {
              "description": "Row order: as given (default) or by rate descending.",
              "enum": [
                "given",
                "rate"
              ],
              "type": "string"
            },
            "target": {
              "description": "Target rate, drawn as the bullet target on every row.",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "component",
            "items",
            "label"
          ],
          "type": "object"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "x-sentropic": {
        "contract": "1.0",
        "element": "st-acceptance-rate-chart",
        "engine": "core",
        "events": [],
        "example": {
          "component": "AcceptanceRateChart",
          "id": "root",
          "items": [
            {
              "accepted": 330,
              "id": "sys-a",
              "label": "System A",
              "total": 400
            },
            {
              "accepted": 3,
              "id": "sys-b",
              "label": "System B",
              "total": 4
            }
          ],
          "label": "Acceptance rate by configuration",
          "target": 0.8
        },
        "fallback": "text",
        "parity": {
          "angular": {
            "file": "packages/components-angular",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "react": {
            "file": "packages/components-react",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "svelte": {
            "file": "packages/elements/src/contracts/acceptance-rate-chart.ts",
            "note": "Reference pilot (§3.1); the catalogue is derived from it.",
            "status": "source-of-truth",
            "type": "AcceptanceRateChartProps"
          },
          "vue": {
            "file": "packages/components-vue",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          }
        },
        "schema": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/AcceptanceRateChart.json"
      }
    }
  },
  "$id": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/AcceptanceRateChart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The envelope schema specialised to one component (§5.2): the §4.2 render envelope (optional catalogId, contract, optional mode, root) whose root is the AcceptanceRateChart component object; its component part ($defs.component) is equivalent, after canonical sorting, to catalog.json#/components/AcceptanceRateChart. Requires the A2UI common types under https://a2ui.org/specification/v0_9_1/common_types.json.",
  "properties": {
    "catalogId": {
      "const": "https://design-system.sent-tech.ca/catalogs/elements/v1/catalog.json",
      "description": "Optional catalogue identifier; absent = the renderer's catalogue (§4.2).",
      "type": "string"
    },
    "contract": {
      "description": "Component-contract version the producer targets (§4.2, §4.4).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "mode": {
      "description": "\"snapshot\" (default) | \"preview\" (reserved, §10.3).",
      "enum": [
        "preview",
        "snapshot"
      ],
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/component"
    }
  },
  "required": [
    "contract",
    "root"
  ],
  "title": "AcceptanceRateChart standalone envelope schema",
  "type": "object",
  "unevaluatedProperties": false
}
