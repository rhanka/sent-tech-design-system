{
  "$defs": {
    "CatalogComponentCommon": {
      "properties": {
        "weight": {
          "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "component": {
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9_1/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "properties": {
            "accessibility": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "component": {
              "const": "ScoreCostChart"
            },
            "costUnit": {
              "description": "Unit printed on the cost axis and in the table, e.g. \"USD per 1k items\".",
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            "frontier": {
              "description": "Draw the Pareto frontier (lowest cost for a given score or better). Default true.",
              "type": "boolean"
            },
            "groups": {
              "description": "Optional groups for categorical tone assignment.",
              "items": {
                "additionalProperties": false,
                "description": "Optional grouping; drives the categorical tone (category1..8) in first-appearance order.",
                "properties": {
                  "id": {
                    "description": "Stable identifier, unique within the chart.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._:-]+$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable name.",
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "type": "object"
              },
              "maxItems": 8,
              "minItems": 0,
              "type": "array"
            },
            "label": {
              "description": "Chart name and accessible name.",
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "points": {
              "description": "Evaluated points in draw order.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "cost": {
                    "description": "Strictly positive cost in `costUnit`.",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000000000,
                    "type": "number"
                  },
                  "groupId": {
                    "description": "Stable identifier, unique within the chart.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._:-]+$",
                    "type": "string"
                  },
                  "id": {
                    "description": "Stable identifier, unique within the chart.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._:-]+$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable name.",
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "score": {
                    "description": "The score (F1 by default).",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "cost",
                  "id",
                  "label",
                  "score"
                ],
                "type": "object"
              },
              "maxItems": 200,
              "minItems": 1,
              "type": "array"
            },
            "scoreLabel": {
              "description": "Axis title of the score. Default \"F1\".",
              "maxLength": 24,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "component",
            "costUnit",
            "label",
            "points"
          ],
          "type": "object"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "x-sentropic": {
        "contract": "1.0",
        "element": "st-score-cost-chart",
        "engine": "core",
        "events": [],
        "example": {
          "component": "ScoreCostChart",
          "costUnit": "USD per 1k items",
          "id": "root",
          "label": "F1 vs inference cost",
          "points": [
            {
              "cost": 0.4,
              "id": "sys-a",
              "label": "System A",
              "score": 0.72
            },
            {
              "cost": 1.8,
              "id": "sys-b",
              "label": "System B",
              "score": 0.86
            }
          ]
        },
        "fallback": "text",
        "parity": {
          "angular": {
            "file": "packages/components-angular",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "react": {
            "file": "packages/components-react",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "svelte": {
            "file": "packages/elements/src/contracts/score-cost-chart.ts",
            "note": "Reference pilot (§3.1); the catalogue is derived from it.",
            "status": "source-of-truth",
            "type": "ScoreCostChartProps"
          },
          "vue": {
            "file": "packages/components-vue",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          }
        },
        "schema": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/ScoreCostChart.json"
      }
    }
  },
  "$id": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/ScoreCostChart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The envelope schema specialised to one component (§5.2): the §4.2 render envelope (optional catalogId, contract, optional mode, root) whose root is the ScoreCostChart component object; its component part ($defs.component) is equivalent, after canonical sorting, to catalog.json#/components/ScoreCostChart. Requires the A2UI common types under https://a2ui.org/specification/v0_9_1/common_types.json.",
  "properties": {
    "catalogId": {
      "const": "https://design-system.sent-tech.ca/catalogs/elements/v1/catalog.json",
      "description": "Optional catalogue identifier; absent = the renderer's catalogue (§4.2).",
      "type": "string"
    },
    "contract": {
      "description": "Component-contract version the producer targets (§4.2, §4.4).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "mode": {
      "description": "\"snapshot\" (default) | \"preview\" (reserved, §10.3).",
      "enum": [
        "preview",
        "snapshot"
      ],
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/component"
    }
  },
  "required": [
    "contract",
    "root"
  ],
  "title": "ScoreCostChart standalone envelope schema",
  "type": "object",
  "unevaluatedProperties": false
}
