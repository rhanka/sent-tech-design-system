{
  "$defs": {
    "CatalogComponentCommon": {
      "properties": {
        "weight": {
          "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "component": {
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9_1/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "properties": {
            "accessibility": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "bands": {
              "description": "Bands in value-axis units, applied to each series.",
              "items": {
                "additionalProperties": false,
                "description": "A shaded band between two value-axis positions.",
                "properties": {
                  "from": {
                    "description": "Band start in value-axis units.",
                    "type": "number"
                  },
                  "label": {
                    "description": "Human-readable band label.",
                    "type": "string"
                  },
                  "to": {
                    "description": "Band end in value-axis units.",
                    "type": "number"
                  },
                  "tone": {
                    "description": "Feedback-token tone for the band.",
                    "enum": [
                      "error",
                      "info",
                      "neutral",
                      "success",
                      "warning"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "component": {
              "const": "TimeSeriesChart"
            },
            "goalLine": {
              "additionalProperties": false,
              "description": "Goal in value-axis units, applied to each series.",
              "properties": {
                "label": {
                  "description": "Human-readable goal label.",
                  "type": "string"
                },
                "value": {
                  "description": "Position of the goal line in value-axis units.",
                  "type": "number"
                }
              },
              "required": [
                "value"
              ],
              "type": "object"
            },
            "label": {
              "description": "Human-readable chart name.",
              "minLength": 1,
              "type": "string"
            },
            "referenceLines": {
              "description": "Reference lines. An x-axis value is in whole UTC epoch milliseconds.",
              "items": {
                "additionalProperties": false,
                "description": "A reference line on one axis (default axis: \"y\").",
                "properties": {
                  "axis": {
                    "description": "Which axis the line spans; \"y\" by default.",
                    "enum": [
                      "x",
                      "y"
                    ],
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable line label.",
                    "type": "string"
                  },
                  "tone": {
                    "description": "Feedback-token tone for the line.",
                    "enum": [
                      "error",
                      "info",
                      "neutral",
                      "success",
                      "warning"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "description": "Position of the line in value-axis units.",
                    "type": "number"
                  }
                },
                "required": [
                  "value"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "series": {
              "description": "Series in display order.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "data": {
                    "description": "Observations in strictly increasing timestamp order.",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "x": {
                          "description": "Whole UTC Unix epoch milliseconds, in the ISO instant range.",
                          "maximum": 8640000000000000,
                          "minimum": -8640000000000000,
                          "type": "integer"
                        },
                        "y": {
                          "description": "Finite measured value.",
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "id": {
                    "description": "Stable identifier, unique within the chart.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable series name.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "data",
                  "id",
                  "label"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "component",
            "label",
            "series"
          ],
          "type": "object"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "x-sentropic": {
        "contract": "1.0",
        "element": "st-time-series-chart",
        "engine": "core",
        "events": [],
        "example": {
          "component": "TimeSeriesChart",
          "id": "root",
          "label": "Queue depth",
          "series": [
            {
              "data": [
                {
                  "x": 1767225600123,
                  "y": 4
                },
                {
                  "x": 1767225601123,
                  "y": 7
                }
              ],
              "id": "jobs",
              "label": "Jobs"
            }
          ]
        },
        "fallback": "text",
        "parity": {
          "angular": {
            "file": "packages/elements/src/element/dom/time-series-chart.svelte",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "react": {
            "file": "packages/elements/src/element/dom/time-series-chart.svelte",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "svelte": {
            "file": "packages/elements/src/element/dom/time-series-chart.svelte",
            "note": "Reference pilot (§3.1); the catalogue is derived from it.",
            "status": "source-of-truth",
            "type": "TimeSeriesChartProps"
          },
          "vue": {
            "file": "packages/elements/src/element/dom/time-series-chart.svelte",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          }
        },
        "schema": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/TimeSeriesChart.json"
      }
    }
  },
  "$id": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/TimeSeriesChart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The envelope schema specialised to one component (§5.2): the §4.2 render envelope (optional catalogId, contract, optional mode, root) whose root is the TimeSeriesChart component object; its component part ($defs.component) is equivalent, after canonical sorting, to catalog.json#/components/TimeSeriesChart. Requires the A2UI common types under https://a2ui.org/specification/v0_9_1/common_types.json.",
  "properties": {
    "catalogId": {
      "const": "https://design-system.sent-tech.ca/catalogs/elements/v1/catalog.json",
      "description": "Optional catalogue identifier; absent = the renderer's catalogue (§4.2).",
      "type": "string"
    },
    "contract": {
      "description": "Component-contract version the producer targets (§4.2, §4.4).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "mode": {
      "description": "\"snapshot\" (default) | \"preview\" (reserved, §10.3).",
      "enum": [
        "preview",
        "snapshot"
      ],
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/component"
    }
  },
  "required": [
    "contract",
    "root"
  ],
  "title": "TimeSeriesChart standalone envelope schema",
  "type": "object",
  "unevaluatedProperties": false
}
