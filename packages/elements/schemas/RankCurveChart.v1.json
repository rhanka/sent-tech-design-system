{
  "$defs": {
    "CatalogComponentCommon": {
      "properties": {
        "weight": {
          "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "component": {
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9_1/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "properties": {
            "accessibility": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "component": {
              "const": "RankCurveChart"
            },
            "itemLabel": {
              "description": "Noun for one ranked item, e.g. \"query\". Default \"item\".",
              "maxLength": 24,
              "minLength": 1,
              "type": "string"
            },
            "label": {
              "description": "Chart name and accessible name.",
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "rankAxis": {
              "description": "x axis: absolute rank (default) or rank as a share of the series length.",
              "enum": [
                "percent",
                "rank"
              ],
              "type": "string"
            },
            "series": {
              "description": "Series to compare as small-multiple rank curves.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "description": "Stable identifier, unique within the chart.",
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._:-]+$",
                    "type": "string"
                  },
                  "label": {
                    "description": "Human-readable name.",
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "values": {
                    "description": "One value per evaluated item, in any order.",
                    "items": {
                      "description": "A proportion.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "maxItems": 2000,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "values"
                ],
                "type": "object"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            "valueLabel": {
              "description": "Axis title of the value. Default \"Recall\".",
              "maxLength": 24,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "component",
            "label",
            "series"
          ],
          "type": "object"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "x-sentropic": {
        "contract": "1.0",
        "element": "st-rank-curve-chart",
        "engine": "core",
        "events": [],
        "example": {
          "component": "RankCurveChart",
          "id": "root",
          "itemLabel": "query",
          "label": "Per-query recall distribution",
          "series": [
            {
              "id": "sys-a",
              "label": "System A",
              "values": [
                0.95,
                0.82,
                0.6,
                0
              ]
            },
            {
              "id": "sys-b",
              "label": "System B",
              "values": [
                0.9,
                0.75,
                0.55,
                0.2
              ]
            }
          ],
          "valueLabel": "Recall"
        },
        "fallback": "text",
        "parity": {
          "angular": {
            "file": "packages/components-angular",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "react": {
            "file": "packages/components-react",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "svelte": {
            "file": "packages/elements/src/contracts/rank-curve-chart.ts",
            "note": "Reference pilot (§3.1); the catalogue is derived from it.",
            "status": "source-of-truth",
            "type": "RankCurveChartProps"
          },
          "vue": {
            "file": "packages/components-vue",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          }
        },
        "schema": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/RankCurveChart.json"
      }
    }
  },
  "$id": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/RankCurveChart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The envelope schema specialised to one component (§5.2): the §4.2 render envelope (optional catalogId, contract, optional mode, root) whose root is the RankCurveChart component object; its component part ($defs.component) is equivalent, after canonical sorting, to catalog.json#/components/RankCurveChart. Requires the A2UI common types under https://a2ui.org/specification/v0_9_1/common_types.json.",
  "properties": {
    "catalogId": {
      "const": "https://design-system.sent-tech.ca/catalogs/elements/v1/catalog.json",
      "description": "Optional catalogue identifier; absent = the renderer's catalogue (§4.2).",
      "type": "string"
    },
    "contract": {
      "description": "Component-contract version the producer targets (§4.2, §4.4).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "mode": {
      "description": "\"snapshot\" (default) | \"preview\" (reserved, §10.3).",
      "enum": [
        "preview",
        "snapshot"
      ],
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/component"
    }
  },
  "required": [
    "contract",
    "root"
  ],
  "title": "RankCurveChart standalone envelope schema",
  "type": "object",
  "unevaluatedProperties": false
}
