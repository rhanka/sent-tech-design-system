            "status": "no-counterpart"
          },
          "react": {
            "file": "packages/components-react",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          },
          "svelte": {
            "file": "packages/elements/src/contracts/precision-recall-chart.ts",
            "note": "Reference pilot (§3.1); the catalogue is derived from it.",
            "status": "source-of-truth",
            "type": "PrecisionRecallChartProps"
          },
          "vue": {
            "file": "packages/components-vue",
            "note": "No counterpart in this framework package (§5.1: components with no framework counterpart record that fact).",
            "status": "no-counterpart"
          }
        },
        "schema": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/PrecisionRecallChart.json"
      }
    }
  },
  "$id": "https://design-system.sent-tech.ca/catalogs/elements/v1/components/PrecisionRecallChart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The envelope schema specialised to one component (§5.2): the §4.2 render envelope (optional catalogId, contract, optional mode, root) whose root is the PrecisionRecallChart component object; its component part ($defs.component) is equivalent, after canonical sorting, to catalog.json#/components/PrecisionRecallChart. Requires the A2UI common types under https://a2ui.org/specification/v0_9_1/common_types.json.",
  "properties": {
    "catalogId": {
      "const": "https://design-system.sent-tech.ca/catalogs/elements/v1/catalog.json",
      "description": "Optional catalogue identifier; absent = the renderer's catalogue (§4.2).",
      "type": "string"
    },
    "contract": {
      "description": "Component-contract version the producer targets (§4.2, §4.4).",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "mode": {
      "description": "\"snapshot\" (default) | \"preview\" (reserved, §10.3).",
      "enum": [
        "preview",
        "snapshot"
      ],
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/component"
    }
  },
  "required": [
    "contract",
    "root"
  ],
  "title": "PrecisionRecallChart standalone envelope schema",
  "type": "object",
  "unevaluatedProperties": false
