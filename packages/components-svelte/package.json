{
  "name": "@sentropic/design-system-svelte",
  "version": "0.41.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/components-svelte"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presence-badge": {
      "svelte": "./dist/presence-badge/index.js",
      "types": "./dist/presence-badge/index.d.ts",
      "import": "./dist/presence-badge/index.js"
    },
    "./diagram-icons": {
      "svelte": "./dist/diagram-icons/index.js",
      "types": "./dist/diagram-icons/index.d.ts",
      "import": "./dist/diagram-icons/index.js"
    },
    "./diagram-render": {
      "types": "./dist/diagram-render/index.d.ts",
      "import": "./dist/diagram-render/index.js"
    },
    "./rich-text-editor": {
      "svelte": "./dist/rich-text-editor/index.js",
      "types": "./dist/rich-text-editor/index.d.ts",
      "import": "./dist/rich-text-editor/index.js"
    },
    "./rich-text-editor.css": "./dist/rich-text-editor/rich-text-editor.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.mjs",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*Fixture.svelte",
    "!dist/**/*Fixture.d.ts",
    "!dist/**/diagram-card-corpus.js",
    "!dist/**/diagram-card-corpus.d.ts",
    "!dist/**/diagram-card-corpus.d.ts.map",
    "!dist/**/diagram-zone-corpus.js",
    "!dist/**/diagram-zone-corpus.d.ts",
    "!dist/**/diagram-zone-corpus.d.ts.map",
    "!dist/**/DiagramSceneFigure.test-support.*",
    "!dist/flow-fixtures/**"
  ],
  "dependencies": {
    "@lucide/svelte": "^0.562.0",
    "@sentropic/design-system-rich-text": "0.1.1",
    "@sentropic/design-system-themes": "0.14.0",
    "@sentropic/diagram-canvas": "0.2.0",
    "@sentropic/graph": "0.3.0"
  },
  "peerDependencies": {
    "svelte": "^5.53.2",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-blockquote": "^3.0.0",
    "@tiptap/extension-bold": "^3.0.0",
    "@tiptap/extension-code": "^3.0.0",
    "@tiptap/extension-code-block": "^3.0.0",
    "@tiptap/extension-document": "^3.0.0",
    "@tiptap/extension-hard-break": "^3.0.0",
    "@tiptap/extension-heading": "^3.0.0",
    "@tiptap/extension-horizontal-rule": "^3.0.0",
    "@tiptap/extension-italic": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extension-paragraph": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-strike": "^3.0.0",
    "@tiptap/extension-text": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig tsconfig.json && svelte-check --tsconfig tsconfig.parity.json",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@sentropic/design-system-theme-dsfr": "0.2.2",
    "@sentropic/design-system-themes": "0.14.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.2.8",
    "@vitejs/plugin-vue": "6.0.11",
    "svelte": "^5.53.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
