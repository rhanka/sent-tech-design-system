    ".st-diagramCard-gap {\n    display: block;\n    height: var(--st-component-diagramCard-gap, 6px);\n    flex: 0 0 var(--st-component-diagramCard-gap, 6px);\n  }",
    ".st-diagramCard-body {\n    \n    min-width: 0;\n    flex: 1 1 auto;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    text-align: center;\n    font-size: var(--st-component-diagramCard-bodyFontSize, 24px);\n    font-weight: var(--st-component-diagramCard-bodyFontWeight, 400);\n    line-height: var(--st-component-diagramCard-bodyLineHeight, 1.3);\n  }",
    ".st-diagramCard-line,\n  .st-diagramCard-detail {\n    display: block;\n    min-width: 0;\n    \n    overflow-wrap: normal;\n    word-break: normal;\n  }",
    ".st-diagramCard-detail {\n    color: var(--st-component-diagramCard-secondaryText, var(--st-semantic-text-secondary));\n  }",
    ".st-diagramCard-foot {\n    margin-top: auto;\n    flex: 0 0 auto;\n  }",
    ".st-diagramCard-rule {\n    display: block;\n    flex: 0 0 auto;\n    \n    height: var(--st-component-diagramCard-ruleHeight, 1px);\n    margin: var(--st-component-diagramCard-ruleMargin, 4px) 0;\n    background: var(--st-component-diagramCard-rule, var(--st-semantic-border-subtle));\n    transform: scaleY(calc(1 / var(--st-diagram-zoom, 1)));\n    transform-origin: center;\n  }",
    ".st-diagramCard-footer {\n    \n    margin-bottom: calc(\n      var(--st-component-diagramCard-footerBottomInset, 9.25px) -\n        var(--st-component-diagramCard-padding, 8px)\n    );\n    font-size: var(--st-component-diagramCard-footerFontSize, 24px);\n    font-weight: var(--st-component-diagramCard-footerFontWeight, 700);\n    line-height: var(--st-component-diagramCard-footerLineHeight, 1.3);\n  }",
    ".st-diagramCard-footerLine {\n    display: block;\n    min-width: 0;\n    overflow-wrap: normal;\n    word-break: normal;\n  }",
    ".st-diagramCardHeader {\n    display: flex;\n    align-items: center;\n    gap: var(--st-component-diagramCard-iconTextGap, 6px);\n    min-width: 0;\n    flex: 0 0 auto;\n  }",
    ".st-diagramCardHeader-icon {\n    flex: 0 0 var(--st-component-diagramCard-iconSize, 70px);\n    width: var(--st-component-diagramCard-iconSize, 70px);\n    height: var(--st-component-diagramCard-iconSize, 70px);\n  }",
    ".st-diagramCardHeader-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    min-width: 0;\n    flex: 0 1 auto;\n  }",
    ".st-diagramCard-kicker {\n    display: block;\n    min-width: 0;\n    font-size: var(--st-component-diagramCard-kickerFontSize, 22px);\n    font-weight: var(--st-component-diagramCard-kickerFontWeight, 400);\n    line-height: var(--st-component-diagramCard-kickerLineHeight, 1.3);\n    letter-spacing: var(--st-component-diagramCard-kickerLetterSpacing, 0.04em);\n    text-transform: var(--st-component-diagramCard-kickerTextTransform, uppercase);\n    color: var(--st-component-diagramCard-secondaryText, var(--st-semantic-text-secondary));\n    \n    overflow-wrap: normal;\n    word-break: normal;\n  }",
    ".st-diagramCard-title {\n    display: block;\n    min-width: 0;\n    font-size: var(--st-component-diagramCard-titleFontSize, 32px);\n    font-weight: var(--st-component-diagramCard-titleFontWeight, 700);\n    line-height: var(--st-component-diagramCard-titleLineHeight, 1.3);\n    color: var(--st-component-diagramCard-text, var(--st-semantic-text-primary));\n    overflow-wrap: normal;\n    word-break: normal;\n  }",
    ".st-diagramCard-toggle {\n    flex: 0 0 auto;\n    margin-left: auto;\n    \n    align-self: flex-start;\n  }"
  ]
}
