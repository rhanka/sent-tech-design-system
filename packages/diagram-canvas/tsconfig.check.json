{
  // `check` compiles the TESTS too. Two suites need a compiler to mean
  // anything: `tests/types-nominal.test.ts` proves a scene item's occurrence
  // reference cannot be passed where an entity reference is required, with one
  // `@ts-expect-error` per illegitimate assignment, and
  // `tests/exhaustive.test.ts` relies on `never` narrowing over the exclusion
  // reason union. Both go green for the wrong reason if no compiler reads them.
  //
  // The build configuration stays test-free: dist ships src only.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Tests read the package's own sources from disk to scan them, so they need
    // node builtins; `src` still compiles with `types: []` under tsconfig.json,
    // which is what keeps the shipped modules free of node and DOM.
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
