{
  "name": "@sentropic/diagram-canvas",
  "version": "0.1.0",
  "description": "Headless scene and hit testing over a diagram view: one world -> view -> CSS pixel -> device pixel transform, deterministic paint order, filter evaluation with reported exclusions. No DOM, no renderer, no framework.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.srchash"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/diagram-canvas"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagramSceneModel": {
      "types": "./dist/presentation/diagramSceneModel.d.ts",
      "import": "./dist/presentation/diagramSceneModel.js"
    },
    "./flowModel": {
      "types": "./dist/presentation/flowModel.d.ts",
      "import": "./dist/presentation/flowModel.js"
    },
    "./diagramCardModel": {
      "types": "./dist/presentation/diagramCardModel.d.ts",
      "import": "./dist/presentation/diagramCardModel.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "dependencies": {
    "@sentropic/diagram-core": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test-support.json && tsc -p tsconfig.host-support.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  }
}
