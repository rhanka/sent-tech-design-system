{
  "name": "@sentropic/diagram-canvas",
  "version": "0.2.0",
  "description": "Headless diagram scenes, layout, hit testing and pure presentation models/SVG helpers. No DOM or framework.",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.srchash",
    "contracts"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/diagram-canvas"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagramCardModel": {
      "types": "./dist/presentation/diagramCardModel.d.ts",
      "import": "./dist/presentation/diagramCardModel.js"
    },
    "./diagramSceneModel": {
      "types": "./dist/presentation/diagramSceneModel.d.ts",
      "import": "./dist/presentation/diagramSceneModel.js"
    },
    "./diagram-icons": {
      "types": "./dist/presentation/registry.d.ts",
      "import": "./dist/presentation/registry.js"
    },
    "./renderCardSvg": {
      "types": "./dist/presentation/renderCardSvg.d.ts",
      "import": "./dist/presentation/renderCardSvg.js"
    },
    "./renderZoneSvg": {
      "types": "./dist/presentation/renderZoneSvg.d.ts",
      "import": "./dist/presentation/renderZoneSvg.js"
    },
    "./diagram-render": {
      "types": "./dist/presentation/index.d.ts",
      "import": "./dist/presentation/index.js"
    },
    "./diagram-anatomy": "./contracts/diagram-anatomy.v1.json",
    "./flowModel": {
      "types": "./dist/presentation/flowModel.d.ts",
      "import": "./dist/presentation/flowModel.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "dependencies": {
    "@sentropic/diagram-core": "0.1.0"
  },
  "scripts": {
    "build": "node ../../scripts/sync-diagram-spacing.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  }
}
