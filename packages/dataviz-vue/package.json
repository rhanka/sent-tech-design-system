{
  "name": "@sentropic/dataviz-vue",
  "version": "0.6.0-next.0",
  "description": "Vue 3 adapter for @sentropic/dataviz-core, built on @sentropic/design-system-vue.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/dataviz-vue"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vapor": {
      "types": "./dist/vapor/index.d.ts",
      "import": "./dist/vapor/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "npm run lint:vapor && vue-tsc -p tsconfig.json && node scripts/build-sfc.mjs",
    "check": "npm run check:types",
    "test": "vitest run",
    "lint:vapor": "node ../../scripts/vue-vapor-lint.mjs",
    "check:types": "vue-tsc -p tsconfig.json --noEmit",
    "build:declarations": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "build:classic-3.5": "node ../../scripts/vue-sfc-build.mjs --stable"
  },
  "dependencies": {
    "@sentropic/dataviz-core": "0.5.0",
    "@sentropic/design-system-themes": "0.13.0",
    "@sentropic/design-system-vue": "0.41.0-next.0",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.7.0"
  },
  "peerDependencies": {
    "vue": "^3.5 || ^3.6.0-0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/server-renderer": "3.6.0-rc.15",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vue": "3.6.0-rc.15",
    "@vue/compiler-sfc": "3.6.0-rc.15",
    "vue-tsc": "3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
