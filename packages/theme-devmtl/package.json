{
  "name": "@sentropic/design-system-theme-devmtl",
  "version": "0.1.0",
  "private": true,
  "description": "/dev/mtl keynote theme mapping for the Sentropic token structure (light v0).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/theme-devmtl"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
