  "type": "module",
  "description": "Private v1 component entry/index schemas and deterministic generator (K1a). Nothing is hosted or published by this package.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/component-index"
  },
  "exports": {
    ".": "./dist/generator/main.js"
  },
  "scripts": {
