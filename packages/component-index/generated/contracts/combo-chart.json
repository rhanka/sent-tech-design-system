                },
                "type": "object"
              }
            ],
            "description": "Per-datum value labels on BOTH the bars and the line points. `false`/absent\n(default) → none. `true` → each value with the chart's numeric formatter.\nObject → `format(value)` and/or a `position` override. Bars default to\n`outside` (above the bar), line points to `top` (above the dot). Labels are\n`aria-hidden` — the values already live in the accessible ChartDataList."
          },
          "height": {
            "type": "number"
          },
          "hiddenSeries": {
            "description": "Interactive legend (FR-4). Ids/labels of bar/line series hidden from the\nrender (controlled by the parent; default = all visible). Hidden series\nare omitted and their legend item is shown \"off\" (`aria-pressed`).\nUndefined → legacy non-interactive legend, unless `onToggleSeries` is set.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "hoverKey": {
            "description": "CONTROLLED synchronised hover key (FR-3). The key is the CATEGORY string.\nWhen provided (string or null), the crosshair tracks this key instead of the\nchart's internal pointer hover (null ⇒ nothing shown), letting a parent share\none hover channel across several aligned charts. Absent (`undefined`) keeps\nthe legacy uncontrolled behaviour.",
            "type": [
              "string",
              "null"
            ]
          },
          "keyboardNav": {
            "description": "FR-5 — keyboard navigation of the data points (roving tabindex). When `true`\n(or implied by wiring `onSelectKey`), a thin focusable overlay is rendered\nover the CATEGORY bands: the chart owns ONE tab stop, ←/↑/→/↓ move the focus\nbetween categories (data order), Home/End jump to first/last, Enter/Space\nselect the focused category (`onSelectKey`), Escape leaves the navigation.\nEach focused band announces its category + value summary. Absent ⇒ no\noverlay, rendering unchanged.",
            "type": "boolean"
          },
