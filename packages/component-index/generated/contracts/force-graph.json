            "type": "array"
          },
          "repulsion": {
            "description": "Repulsion multiplier controlling how spread out the layout is.\n>1 = graphe plus aéré, <1 = plus compact ; multiplie la force de\nrépulsion sans toucher au fit-to-content. Defaults to 1. Clamped to\n[0.1, 10] internally to avoid layout explosions/collapses.",
            "type": "number"
          },
          "resetViewLabel": {
            "description": "Accessible label for the reset-view button (shown when zoomed/panned).",
            "type": "string"
          },
          "selectedIds": {
            "description": "IDs of currently selected nodes. Highlighted visually without\nre-running the layout. Defaults to [].",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "showLabels": {
            "description": "Show text labels next to nodes.",
            "type": "boolean"
          },
          "width": {
