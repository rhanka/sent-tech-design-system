{
  "name": "@sentropic/design-system-vue",
  "version": "0.40.0",
  "license": "MIT",
  "description": "Vue 3 components for the Sentropic design system.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sent-tech-design-system.git",
    "directory": "packages/components-vue"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./diagram-icons": {
      "types": "./dist/diagram-icons/index.d.ts",
      "import": "./dist/diagram-icons/index.js"
    },
    "./diagram-render": {
      "types": "./dist/diagram-render/index.d.ts",
      "import": "./dist/diagram-render/index.js"
    },
    "./vapor": {
      "types": "./dist/vapor/index.d.ts",
      "import": "./dist/vapor/index.js"
    },
    "./vapor/diagram-icons": {
      "types": "./dist/vapor/diagram-icons/index.d.ts",
      "import": "./dist/vapor/diagram-icons/index.js"
    },
    "./bpmn": {
      "types": "./dist/bpmn/index.d.ts",
      "import": "./dist/bpmn/index.js"
    },
    "./vapor/bpmn": {
      "types": "./dist/vapor/bpmn/index.d.ts",
      "import": "./dist/vapor/bpmn/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.json && node scripts/build-sfc.mjs && node scripts/copy-styles.mjs && node scripts/check-published-types.mjs",
    "check": "npm run build",
    "test": "vitest run src"
  },
  "dependencies": {
    "@sentropic/design-system-themes": "0.13.0",
    "lucide-vue-next": "^0.562.0",
    "@sentropic/diagram-canvas": "0.1.0",
    "@sentropic/graph": "0.3.0"
  },
  "peerDependencies": {
    "vue": "^3.5 || ^3.6.0-0",
    "@sentropic/design-system-elements": "0.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "3.6.0-rc.15",
    "@vue/server-renderer": "3.6.0-rc.15",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue": "3.6.0-rc.15",
    "vue-tsc": "^2.2.12"
  },
  "peerDependenciesMeta": {
    "@sentropic/design-system-elements": {
      "optional": true
    }
  }
}
